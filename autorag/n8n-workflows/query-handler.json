{
  "name": "AutoRAG — Query Handler (Slack /ask)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "Slack Slash Command Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 400],
      "webhookId": "autorag-slack-query"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"response_type\": \"in_channel\",\n  \"text\": \"🔍 Searching knowledge base for: *{{ $json.body.text }}*\"\n}",
        "options": { "responseCode": 200 }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Immediate Slack ACK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [240, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://autorag-production.up.railway.app/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"question\": \"{{ $('Slack Slash Command Webhook').item.json.body.text }}\",\n  \"top_k\": 5\n}",
        "options": {
          "timeout": 60000,
          "response": { "response": { "fullResponse": false, "responseFormat": "json" } }
        }
      },
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "POST /query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 540]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.answer }}",
              "rightValue": "could not find relevant information",
              "operator": { "type": "string", "operation": "notContains" }
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "Answer Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 540]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('Slack Slash Command Webhook').item.json.body.channel_id }}",
          "mode": "id"
        },
        "blocksUi": {
          "blocksValues": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "💬 Answer"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "={{ $json.answer }}"
              }
            },
            {
              "type": "divider"
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "=📚 *Sources:*\n{{ $json.sources.map(s => `• *${s.metadata.filename}* — ${s.metadata.text_preview.substring(0, 100)}…`).join('\\n') }}"
              }
            },
            {
              "type": "context",
              "elements": [
                {
                  "type": "mrkdwn",
                  "text": "=Model: `{{ $json.model_used }}` | Latency: {{ $json.latency_ms }}ms | Tokens: {{ $json.token_count }} | HyDE: {{ $json.hyde_used }}"
                }
              ]
            }
          ]
        },
        "otherOptions": { "mrkdwn": true }
      },
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "Slack — Answer",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [720, 400],
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack AutoRAG" }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('Slack Slash Command Webhook').item.json.body.channel_id }}",
          "mode": "id"
        },
        "text": "=🤷 *No relevant information found*\nI searched the knowledge base but couldn't find information to answer:\n> _{{ $('Slack Slash Command Webhook').item.json.body.text }}_\n\nTry uploading relevant documents to the autorag-docs Google Drive folder.",
        "otherOptions": { "mrkdwn": true }
      },
      "id": "b2c3d4e5-0006-0006-0006-000000000006",
      "name": "Slack — No Answer",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [720, 680],
      "credentials": {
        "slackApi": { "id": "3", "name": "Slack AutoRAG" }
      }
    }
  ],
  "connections": {
    "Slack Slash Command Webhook": {
      "main": [
        [
          { "node": "Immediate Slack ACK", "type": "main", "index": 0 },
          { "node": "POST /query", "type": "main", "index": 0 }
        ]
      ]
    },
    "POST /query": {
      "main": [[{ "node": "Answer Found?", "type": "main", "index": 0 }]]
    },
    "Answer Found?": {
      "main": [
        [{ "node": "Slack — Answer", "type": "main", "index": 0 }],
        [{ "node": "Slack — No Answer", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "AutoRAG — Error Handler"
  },
  "staticData": null,
  "tags": [{ "name": "autorag" }, { "name": "query" }, { "name": "slack" }],
  "triggerCount": 1,
  "updatedAt": "2026-06-24T17:30:00.000Z",
  "versionId": "1"
}
