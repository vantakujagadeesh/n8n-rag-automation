        "text": "=🔔 <@here> *CRITICAL ERROR — immediate attention required!*\nWorkflow `{{ $json.workflow_name }}` has failed with a critical error.\nError: `{{ $json.error_message }}`\nPlease check the n8n dashboard and the Railway logs immediately.",
        "otherOptions": { "mrkdwn": true }
