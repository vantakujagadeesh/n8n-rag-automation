# ══════════════════════════════════════════════════════════════════════════════
# AutoRAG — Environment Variables
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── Qdrant (vector database) ─────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=documents

# ── Redis (caching) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── PostgreSQL (metadata store) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/autorag

# ── Slack (optional — alerts & notifications) ────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_SIGNING_SECRET=your-slack-signing-secret

# ── AWS S3 (optional — document storage) ─────────────────────────────────────
# S3_BUCKET=autorag-documents
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# ── n8n (optional — workflow webhooks) ───────────────────────────────────────
# N8N_WEBHOOK_BASE=https://your-n8n-instance.app.n8n.cloud/webhook

# ── Embedding model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=3072

# ── LLM models ───────────────────────────────────────────────────────────────
PRIMARY_LLM=gpt-4o
FALLBACK_LLM=claude-sonnet-4-6

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── App settings ─────────────────────────────────────────────────────────────
APP_NAME=AutoRAG
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── RAG pipeline tuning ──────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
QUERY_CACHE_TTL=3600
HYDE_ENABLED=true
HYBRID_SEARCH_ENABLED=true
